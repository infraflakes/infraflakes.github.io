fn build_portfolio {
  cd `landing-page`;
  exec `nix develop -c bun install`;
  exec `nix develop -c bun run build`;
}

fn fmt_portfolio {
  cd `landing-page`;
  exec `nix develop -c biome format --write .`;
  exec `nix develop -c biome format .`;
}

fn lint_portfolio {
  cd `landing-page`;
  exec `nix develop -c biome lint --write .`;
  exec `nix develop -c biome lint .`;
}

pr portfolio {
  use build_portfolio as build;
  use fmt_portfolio as fmt;
  use lint_portfolio as lint;
}

run test_portfolio {
  portfolio::fmt => portfolio::lint => portfolio::build;
}
